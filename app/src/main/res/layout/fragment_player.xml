<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_scroll_view"
    style="@style/backgroundColorActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.12" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.88" />

        <!-- Кнопка назад: ID и стиль сохранены -->
        <ImageView
            android:id="@+id/back_button"
            style="@style/backIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_arrow_back_48x48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/big_cover_track"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/back_button"
            tools:src="@drawable/ic_placeholder_image" />

        <TextView
            android:id="@+id/track_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/big_cover_track"
            tools:text="Yesterday (Remastered 2009)" />

        <TextView
            android:id="@+id/artist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/track_name"
            tools:text="The Beatles" />

        <ImageView
            android:id="@+id/to_playlist_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_to_playlist_51x51"
            app:layout_constraintBottom_toBottomOf="@id/button_anchor"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toTopOf="@id/button_anchor" />

        <!-- Невидимый якорь для центрирования кнопок управления -->
        <ImageView
            android:id="@+id/button_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_play_100x100"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/artist_name" />

        <ImageView
            android:id="@+id/play_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play_100x100"
            app:layout_constraintBottom_toBottomOf="@id/button_anchor"
            app:layout_constraintEnd_toEndOf="@id/button_anchor"
            app:layout_constraintStart_toStartOf="@id/button_anchor"
            app:layout_constraintTop_toTopOf="@id/button_anchor" />

        <ImageView
            android:id="@+id/pause_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pausebutton_100x100"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/button_anchor"
            app:layout_constraintEnd_toEndOf="@id/button_anchor"
            app:layout_constraintStart_toStartOf="@id/button_anchor"
            app:layout_constraintTop_toTopOf="@id/button_anchor" />

        <ImageView
            android:id="@+id/to_favorite_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_to_favorites_51x51"
            app:layout_constraintBottom_toBottomOf="@id/button_anchor"
            app:layout_constraintEnd_toEndOf="@id/right_guideline"
            app:layout_constraintTop_toTopOf="@id/button_anchor" />

        <TextView
            android:id="@+id/playback_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_anchor"
            tools:text="0:30" />

        <!-- Информационный блок -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/labels_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="track_length,collection_name,release,primary_genre_name,country" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline_16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline_16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="16dp" />

        <TextView
            android:id="@+id/track_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="Длительность"
            android:textColor="@color/yp_textGray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/left_guideline_16dp"
            app:layout_constraintTop_toBottomOf="@id/playback_progress" />

        <TextView
            android:id="@+id/track_length_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@id/track_length"
            app:layout_constraintEnd_toEndOf="@+id/right_guideline_16dp"
            app:layout_constraintStart_toEndOf="@id/labels_barrier"
            tools:text="5:35" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/collection_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="collection_name,collection_name_data" />

        <TextView
            android:id="@+id/collection_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="Альбом"
            android:textColor="@color/yp_textGray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/left_guideline_16dp"
            app:layout_constraintTop_toBottomOf="@id/track_length" />

        <TextView
            android:id="@+id/collection_name_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            app:layout_constraintBaseline_toBaselineOf="@id/collection_name"
            app:layout_constraintEnd_toEndOf="@+id/right_guideline_16dp"
            app:layout_constraintStart_toEndOf="@id/labels_barrier"
            tools:text="Yesterday (Remastered 2009)" />

        <TextView
            android:id="@+id/release"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="Год"
            android:textColor="@color/yp_textGray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/left_guideline_16dp"
            app:layout_constraintTop_toBottomOf="@id/collection_name" />

        <TextView
            android:id="@+id/release_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@id/release"
            app:layout_constraintEnd_toEndOf="@+id/right_guideline_16dp"
            app:layout_constraintStart_toEndOf="@id/labels_barrier"
            tools:text="1965" />

        <TextView
            android:id="@+id/primary_genre_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="Жанр"
            android:textColor="@color/yp_textGray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/left_guideline_16dp"
            app:layout_constraintTop_toBottomOf="@id/release" />

        <TextView
            android:id="@+id/primary_genre_name_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@id/primary_genre_name"
            app:layout_constraintEnd_toEndOf="@+id/right_guideline_16dp"
            app:layout_constraintStart_toEndOf="@id/labels_barrier"
            tools:text="Rock" />

        <TextView
            android:id="@+id/country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="Страна"
            android:textColor="@color/yp_textGray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/left_guideline_16dp"
            app:layout_constraintTop_toBottomOf="@id/primary_genre_name" />

        <TextView
            android:id="@+id/country_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@id/country"
            app:layout_constraintEnd_toEndOf="@+id/right_guideline_16dp"
            app:layout_constraintStart_toEndOf="@id/labels_barrier"
            tools:text="Великобритания" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>