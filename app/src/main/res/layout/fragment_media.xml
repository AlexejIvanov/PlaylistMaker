<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media"
    style="@style/backgroundColorActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".media.presentation.MediaFragment">

    <!-- Заголовок экрана (без кнопки назад) -->
    <com.google.android.material.appbar.MaterialToolbar
        style="@style/nameActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/media_library"
        app:titleTextColor="?attr/colorOnSurface" />

    <!-- Табы для переключения между фрагментами -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabIndicatorColor="?attr/colorOnSurface"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="2dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="?attr/colorOnSurface"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabTextColor="?attr/colorOnSurface" />

    <!-- Линия-разделитель (как была у вас) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yp_textGray" />

    <!-- Контейнер для фрагментов (Избранное и Плейлисты) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>